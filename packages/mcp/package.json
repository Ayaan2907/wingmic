{
  "name": "@wingmic/mcp",
  "version": "0.1.0",
  "private": true,
  "description": "wingmic MCP server — search_network, log_interaction, get_person, create_followup over the public REST v1 API (stdio transport)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "wingmic-mcp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm --dts --clean --sourcemap",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "tsup src/index.ts src/cli.ts --format esm --clean --silent && bun scripts/smoke.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@wingmic/config-tsconfig": "workspace:*",
    "@wingmic/config-vitest": "workspace:*",
    "tsup": "^8.0.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.5"
  }
}
