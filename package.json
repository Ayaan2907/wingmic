{
  "name": "wingmic",
  "version": "0.1.0-beta.0",
  "private": true,
  "description": "Voice-first networking memory. Your social RAM, on disk.",
  "license": "MIT",
  "homepage": "https://wingmic.xyz",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ayaan2907/wingmic.git"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/config/*"
  ],
  "scripts": {
    "dev":                "turbo dev --env-mode=loose",
    "dev:web":            "turbo dev --filter=@wingmic/web --env-mode=loose",
    "dev:app":            "turbo dev --filter=@wingmic/app --env-mode=loose",
    "dev:doppler":        "doppler run -- bun run dev",
    "dev:web:doppler":    "doppler run -- bun run dev:web",
    "dev:app:doppler":    "doppler run -- bun run dev:app",
    "build":              "turbo build",
    "build:app":          "turbo build --filter=@wingmic/app --env-mode=loose",
    "start:app":          "bun --filter @wingmic/app start",
    "build:doppler":      "doppler run -- bun run build",
    "test":               "turbo test",
    "lint":               "turbo lint",
    "typecheck":          "turbo typecheck",
    "format":             "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check":       "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "db:generate":        "bun --filter=@wingmic/db generate",
    "db:apply":           "bun --filter=@wingmic/db apply",
    "db:migrate:deploy":  "sh scripts/predeploy-migrate.sh",
    "db:studio":          "bun --filter=@wingmic/db studio",
    "db:apply:doppler":   "doppler run -- bun run db:apply",
    "db:studio:doppler":  "doppler run -- bun run db:studio",
    "extract:eval":       "bun --filter=@wingmic/extractor eval",
    "extract:eval:doppler":"doppler run -- bun run extract:eval",
    "clean":              "rm -rf node_modules apps/*/node_modules packages/*/node_modules packages/config/*/node_modules .turbo apps/*/.turbo packages/*/.turbo apps/app/.next apps/web/.next apps/web/out packages/brand/dist packages/db/dist packages/design-tokens/dist packages/extractor/dist coverage .open-next .vercel && find . -name '*.tsbuildinfo' -not -path './node_modules/*' -delete 2>/dev/null || true",
    "reinstall":          "bun run clean && bun install"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "tsup": "^8.5.1",
    "turbo": "^2.9.12",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20",
    "bun": ">=1.1"
  },
  "packageManager": "bun@1.3.10"
}
