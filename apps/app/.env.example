# ── Database (libSQL / Turso) ────────────────────────────────────────────
# Local dev: leave blank (defaults to file:./local.db).
# Prod (Turso):
#   TURSO_DB_URL=libsql://your-db-name.turso.io
#   TURSO_AUTH_TOKEN=eyJ...
TURSO_DB_URL=
TURSO_AUTH_TOKEN=

# ── Authentication (BetterAuth) ──────────────────────────────────────────
# Generate a random 32+ byte secret: openssl rand -base64 48
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3211
# Public mirror of BETTER_AUTH_URL for the client-side auth client.
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3211
# In production:
#   BETTER_AUTH_URL=https://app.wingmic.xyz
#   NEXT_PUBLIC_BETTER_AUTH_URL=https://app.wingmic.xyz
#   NEXT_PUBLIC_APP_URL=https://app.wingmic.xyz

# ── Email (Resend) — for magic links ─────────────────────────────────────
# Local dev: leave RESEND_API_KEY blank — magic links log to dev-server console.
# Prod: API key + verified sending domain at resend.com.
RESEND_API_KEY=
# Sender display name + address. Default: `wingmic <auth@wingmic.xyz>`.
# Override with your verified domain in prod.
RESEND_FROM=

# ── Unified provider — OpenRouter (LLM + embeddings) ─────────────────────
# v0.1.1 "Hosted Capture" locked decision #9. Get a key at openrouter.ai.
# Both LLM calls (Claude Haiku 4.5 for hybrid extractor relations) and
# embeddings (text-embedding-3-small for entity + recall) route through
# OpenRouter at provider-parity pricing.
OPENROUTER_API_KEY=

# ── ASR — AssemblyAI (direct, batch transcription) ───────────────────────
# v0.1.1 locked decision #1. Get a key at assemblyai.com.
ASSEMBLYAI_API_KEY=

# ── Model selection (optional overrides) ─────────────────────────────────
# Defaults match v0.1.1 locked decisions #4 and #5.
# Swap LLM providers without code change by setting the OpenRouter model
# string, e.g., openai/gpt-4o-mini, google/gemini-2.5-flash.
EXTRACTION_MODEL=
LINKER_MODEL=
EMBEDDING_MODEL=

# ── Public app URL ───────────────────────────────────────────────────────
# Used by the tRPC client for server-side base URL resolution.
# Production: https://wingmic.xyz (no trailing slash).
NEXT_PUBLIC_APP_URL=

# ── Runtime ──────────────────────────────────────────────────────────────
# NODE_ENV is set by Next.js / Bun automatically. PORT defaults to 3210.
# CI=true is set by GitHub Actions automatically.
